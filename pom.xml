<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.uetlib</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.11.1</version>
        <relativePath/>
    </parent>

    <artifactId>uetlib-testcontainers-parent</artifactId>

    <packaging>pom</packaging>
    <version>4.0.0-SNAPSHOT</version>

    <name>uetlib-testcontainers-parent</name>
    <description>Reusable Testcontainers configurations for integration tests.</description>
    <url>https://github.com/UbiqueInnovation/uetlib-testcontainers</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <organization>
        <name>Ubique Innovation AG</name>
        <url>https://www.ubique.ch</url>
    </organization>
    <developers>
        <developer>
            <name>Ubique Innovation AG</name>
            <organization>Ubique Innovation AG</organization>
            <organizationUrl>https://www.ubique.ch</organizationUrl>
        </developer>
    </developers>

    <modules>
        <module>uetlib-testcontainers</module>
        <module>uetlib-testcontainers-mariadb</module>
        <module>uetlib-testcontainers-mongodb</module>
        <module>uetlib-testcontainers-mysql</module>
        <module>uetlib-testcontainers-postgresql</module>
        <module>uetlib-testcontainers-influxdb</module>
        <module>uetlib-testcontainers-redis</module>
        <module>uetlib-testcontainers-kafka</module>
        <module>uetlib-testcontainers-coverage</module>
    </modules>

    <properties>
        <sonar.projectName>uetlib-testcontainers</sonar.projectName>
        <sonar.coverage.module>uetlib-testcontainers-coverage</sonar.coverage.module>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-test</artifactId>
                <version>3.0.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-test</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.xmlunit</groupId>
                    <artifactId>xmlunit-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
        </dependency>
    </dependencies>



    <scm child.scm.url.inherit.append.path="false" child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false">
        <connection>scm:git:https://github.com/UbiqueInnovation/uetlib-testcontainers.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/UbiqueInnovation/uetlib-testcontainers.git</developerConnection>
        <url>https://github.com/UbiqueInnovation/uetlib-testcontainers</url>
    </scm>
</project>
