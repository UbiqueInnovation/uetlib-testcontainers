<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>

    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-testcontainers-parent</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>uetlib-testcontainers-coverage</artifactId>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

        <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-postgresql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-mysql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-mariadb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-influxdb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

<dependencies>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-influxdb</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-mariadb</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-kafka</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <scm>
        <url>https://github.com/UbiqueInnovation/uetlib-testcontainers</url>
    </scm>
</project>